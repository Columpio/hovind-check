---
import ArticlePage from '../../components/ArticlePage.astro';
import { getRhetoric } from '../../lib/data';
export function getStaticPaths() {
  return getRhetoric().map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
---
<ArticlePage kind="rhetoric" article={article} />
