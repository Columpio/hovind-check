---
import ArticlePage from '../../components/ArticlePage.astro';
import { withFrequency } from '../../lib/data';
export function getStaticPaths() {
  return withFrequency('arguments').map(({ article }) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
---
<ArticlePage kind="arguments" article={article} />
