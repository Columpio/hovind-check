---
import Base from '../../layouts/Base.astro';
import { getLectures, getClaims, lectureLabel } from '../../lib/data';
const base = import.meta.env.BASE_URL;
const lectures = getLectures().map((l) => ({ ...l, n: getClaims(l.slug).length }));
---
<Base title="Лекции" section="lectures">
  <div class="wrap narrow">
    <h1>Лекции</h1>
    <ul class="cards">
      {lectures.map((l) => (
        <li>
          <a class="card" href={`${base}lectures/${l.slug}/`}>
            <span class="t">{lectureLabel(l)}</span>
            <span class="s">{l.source}{l.n > 0 ? ` · утверждений: ${l.n}` : ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
