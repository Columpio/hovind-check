---
import '../../styles/lecture.css';
import Base from '../../layouts/Base.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import ClaimItem from '../../components/ClaimItem.astro';
import RatingFilter from '../../components/RatingFilter.astro';
import { getLectures, getClaims, lectureLabel } from '../../lib/data';

export function getStaticPaths() {
  const lectures = getLectures();
  return lectures.map((lecture, i) => ({
    params: { slug: lecture.slug },
    props: { lecture, prev: lectures[i - 1] ?? null, next: lectures[i + 1] ?? null },
  }));
}
const { lecture, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const claims = getClaims(lecture.slug);
---
<Base title={lectureLabel(lecture)} section="lectures">
  <div class="wrap">
    <header class="lecture-head">
      <p class="meta"><a href={`${base}lectures/`}>← Все лекции</a></p>
      <h1>{lectureLabel(lecture)}</h1>
      {lecture.draft && <div class="draft-note">Черновик: разбор ещё не вычитан. Подробные статьи к части доводов готовятся.</div>}
    </header>

    <div class="lecture-grid">
      <div class="video-col">
        <VideoPlayer lecture={lecture} />
        {claims.length > 0 && <RatingFilter claims={claims} />}
      </div>

      <section class="claims-col" aria-label="Разбор утверждений">
        {claims.length === 0 ? (
          <div class="draft-note">Разбор этой лекции готовится. Видео можно посмотреть уже сейчас.</div>
        ) : (
          <div class="claims" id="claims">
            {claims.map((claim) => <ClaimItem claim={claim} />)}
            <p class="empty-filter" id="empty-filter" hidden>Все утверждения скрыты. Включите хотя бы одну оценку в списке «Оценки».</p>
          </div>
        )}

        <nav class="lecture-pager" aria-label="Другие лекции">
          {prev && <a class="prev" href={`${base}lectures/${prev.slug}/`}><small>← Предыдущая</small><b>{lectureLabel(prev)}</b></a>}
          {next && <a class="next" href={`${base}lectures/${next.slug}/`}><small>Следующая →</small><b>{lectureLabel(next)}</b></a>}
          <a class="all" href={`${base}lectures/`}><b>Все лекции</b></a>
        </nav>
      </section>
    </div>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <p class="lecture-credits" slot="footer">
    <b>Об этом видео.</b> {lecture.author}. {lecture.source}. {lecture.voiceover}. Источник видео:{' '}
    {lecture.youtube?.id && <><a href={`https://www.youtube.com/watch?v=${lecture.youtube.id}`}>YouTube</a>{lecture.youtube.channel && ` (канал «${lecture.youtube.channel}»)`}</>}
    {lecture.rutube?.id && <>, <a href={`https://rutube.ru/video/${lecture.rutube.id}/`}>RuTube</a>{lecture.rutube.channel && ` (канал «${lecture.rutube.channel}»)`}</>}.
    Права: {lecture.rights}.
  </p>
</Base>

<script>
  import '../../scripts/lecture';
</script>
