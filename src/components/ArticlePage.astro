---
import Base from '../layouts/Base.astro';
import RatingPill from './RatingPill.astro';
import ChannelVideos from './ChannelVideos.astro';
import { occurrences, related, similar, backlinks, formatTime, timeFragment, lectureLabel, type Article, type CatalogKind } from '../lib/data';
import { pluralRu } from '../lib/time';
interface Props { kind: CatalogKind; article: Article; }
const { kind, article } = Astro.props;
const base = import.meta.env.BASE_URL;
const occ = occurrences(kind, article.slug);
const rel = related(kind, article.slug);
const sim = similar(kind, article.slug);
const back = backlinks(kind, article.slug);
const similarTitle = kind === 'arguments' ? 'Похожие доводы' : 'Похожие приёмы';
const kindLabel = (k: CatalogKind) => (k === 'arguments' ? 'довод' : 'приём');
const otherKind = kind === 'arguments' ? 'rhetoric' : 'arguments';
const catalogTitle = kind === 'arguments' ? 'Каталог доводов' : 'Риторические приёмы';
const relTitle = kind === 'arguments' ? 'Какими приёмами Ховинд подкрепляет этот довод' : 'В каких доводах встречается этот приём';
const together = (n: number) => `вместе ${n} ${pluralRu(n, 'раз', 'раза', 'раз')}`;
// Длинный список мест сворачиваем: иначе до конца страницы на телефоне десятки экранов.
const OCC_SHOWN = 6;
const occFirst = occ.length > OCC_SHOWN + 2 ? occ.slice(0, OCC_SHOWN) : occ;
const occRest = occ.length > OCC_SHOWN + 2 ? occ.slice(OCC_SHOWN) : [];
---
<Base title={article.title} description={article.summary} section={kind}>
  <div class="wrap narrow">
    <p class="meta"><a class="back-link" href={`${base}${kind}/`}>← {catalogTitle}</a></p>
    <h1>{article.title}</h1>
    <p class="lead">{article.summary}</p>
    {article.pending
      ? <p class="pending-note">Подробный разбор {kind === 'arguments' ? 'этого довода' : 'этого приёма'} готовится. Ниже — все места в лекциях, где он встречается, с нашими короткими ответами.</p>
      : <div class="article-body prose" set:html={article.html} />}

    {!article.pending && <ChannelVideos videos={article.videos} />}

    {rel.length > 0 && (
      <section>
        <h2>{relTitle}</h2>
        <ul class="chips">
          {rel.map(({ article: a, count }) => (
            <li><a class="chip" href={`${base}${otherKind}/${a.slug}/`}><b>{a.title}</b><span class="n">· {together(count)}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    {sim.length > 0 && (
      <section>
        <h2>{similarTitle}</h2>
        <p class="meta">Ховинд часто говорит об этом рядом, или на них ссылается разбор.</p>
        <ul class="chips">
          {sim.map((a) => (
            <li><a class="chip" href={`${base}${kind}/${a.slug}/`}><b>{a.title}</b></a></li>
          ))}
        </ul>
      </section>
    )}

    {back.length > 0 && (
      <section>
        <h2>На этот разбор ссылаются</h2>
        <ul class="chips">
          {back.map(({ kind: k, article: a }) => (
            <li><a class="chip" href={`${base}${k}/${a.slug}/`}><b>{a.title}</b>{k !== kind && <span class="n">· {kindLabel(k)}</span>}</a></li>
          ))}
        </ul>
      </section>
    )}

    <h2>Где встречается в лекциях ({occ.length})</h2>
    {occ.length === 0 ? (
      <p class="meta">Пока не отмечено ни в одной лекции.</p>
    ) : (
      <>
        {[occFirst, occRest].filter((list) => list.length > 0).map((list, i) => {
          const items = (
            <ul class="occ">
              {list.map(({ lecture, claim }) => (
                <li>
                  <span class="where">
                    <a class="occ-link" href={`${base}lectures/${lecture.slug}/#t=${timeFragment(claim.start)}`}>
                      {lectureLabel(lecture)}, {formatTime(claim.start)}
                    </a>
                    <RatingPill rating={claim.rating} />
                  </span>
                  <q>{claim.text}</q>
                </li>
              ))}
            </ul>
          );
          return i === 0 ? items : (
            <details class="occ-more">
              <summary class="btn">Показать все {occ.length}</summary>
              {items}
            </details>
          );
        })}
      </>
    )}
  </div>
</Base>
