---
import { offsetSteps, getFeedback, type Lecture } from '../lib/data';
interface Props { lecture: Lecture; }
const { lecture } = Astro.props;
const ytId = lecture.youtube?.id ?? '';
const rtId = lecture.rutube?.id ?? '';
const feedback = getFeedback();
---
<div
  class="player"
  id="player"
  data-yt-id={ytId}
  data-yt-offsets={JSON.stringify(offsetSteps(lecture.youtube))}
  data-rt-id={rtId}
  data-rt-offsets={JSON.stringify(offsetSteps(lecture.rutube))}
>
  <div class="player-frame">
    <noscript>
      <div class="player-msg">
        <p>Встроенный плеер работает только с включённым JavaScript.</p>
        {ytId && <p><a href={`https://www.youtube.com/watch?v=${ytId}`}>Смотреть на YouTube</a></p>}
        {rtId && <p><a href={`https://rutube.ru/video/${rtId}/`}>Смотреть на RuTube</a></p>}
      </div>
    </noscript>
  </div>
  <div class="player-bar">
    <div class="switch" role="group" aria-label="Откуда смотреть видео">
      <button type="button" data-platform="youtube" disabled={!ytId} aria-pressed="false">YouTube</button>
      <button type="button" data-platform="rutube" disabled={!rtId} aria-pressed="false">RuTube</button>
    </div>
    <span class="spacer"></span>
    <button type="button" class="btn" id="to-current" title="Прокрутить разбор к месту, до которого дошло видео" aria-label="К месту видео в разборе">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
      <span class="lbl" aria-hidden="true">К месту<span class="lbl-long"> видео</span></span>
    </button>
    <button type="button" class="btn mini-toggle" id="mini-toggle" aria-expanded="true" aria-controls="player" title="Свернуть или развернуть видео">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
      <span class="when-open">Свернуть</span><span class="when-mini" hidden>Видео</span>
    </button>
  </div>
  <p class="player-note">Нажмите на время у любого утверждения, и видео включится с этого места.</p>
  {feedback && <p class="player-note">Нашли ошибку? Выделите текст, чтобы отправить замечание к этому месту, или нажмите «Напишите нам» внизу страницы.</p>}
</div>
