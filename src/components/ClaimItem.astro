---
import RatingPill from './RatingPill.astro';
import { formatTime, timeFragment, md, getArticle, type Claim } from '../lib/data';
interface Props { claim: Claim; }
const { claim } = Astro.props;
const base = import.meta.env.BASE_URL;
const frag = timeFragment(claim.start);
const bodyId = `${claim.id}-body`;
const collapsed = claim.rating === 'neutral';
const args = (claim.arguments ?? []).map((s) => getArticle('arguments', s));
const rhet = (claim.rhetoric ?? []).map((s) => getArticle('rhetoric', s));
---
<article
  class={`claim r-${claim.rating}`}
  id={`t=${frag}`}
  data-id={claim.id}
  data-rating={claim.rating}
  data-start={claim.start}
  data-end={claim.end}
  aria-label={`Утверждение с ${formatTime(claim.start)}`}
>
  <div class="claim-head">
    <button type="button" class="tc" data-seek={claim.start} aria-label={`Включить видео с ${formatTime(claim.start)}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg>
      {formatTime(claim.start)}
    </button>
    <RatingPill rating={claim.rating} />
    <a class="anchor" href={`#t=${frag}`} title="Ссылка на это утверждение" aria-label={`Ссылка на утверждение с ${formatTime(claim.start)}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
    </a>
    <button type="button" class="fold" aria-expanded={collapsed ? 'false' : 'true'} aria-controls={bodyId} title={collapsed ? 'Показать разбор' : 'Скрыть разбор'}>
      <span class="sr-only">Разбор</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  </div>

  <blockquote class="quote">
    <span class="part-label">Ховинд говорит</span>
    <p>{claim.text}</p>
  </blockquote>

  <div class="claim-body" id={bodyId} hidden={collapsed}>
    <span class="part-label analysis-label">Наш разбор</span>
    <p class="verdict">{claim.verdict}</p>
    {claim.details && (
      <details class="more">
        <summary>Подробнее</summary>
        <div class="prose" set:html={md(claim.details)} />
      </details>
    )}
    {args.map((a) => (
      <aside class="inset" aria-label={`Повторяющийся довод: ${a.title}`}>
        <div class="inset-label">Повторяющийся довод: <a href={`${base}arguments/${a.slug}/`}>{a.title}</a></div>
        <p class="inset-summary">{a.summary}</p>
        {a.html && (
          <details class="more">
            <summary>Разбор довода</summary>
            <div class="prose" set:html={a.html} />
          </details>
        )}
      </aside>
    ))}
    {rhet.length > 0 && (
      <ul class="chips" aria-label="Риторические приёмы">
        {rhet.map((r) => (
          <li><a class="chip" href={`${base}rhetoric/${r.slug}/`} title={r.summary}>Риторический приём: <b>{r.title}</b></a></li>
        ))}
      </ul>
    )}
  </div>
</article>
