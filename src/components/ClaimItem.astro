---
import RatingPill from './RatingPill.astro';
import { formatTime, timeFragment, getArticle, type Claim } from '../lib/data';
interface Props { claim: Claim; speaker: string; }
const { claim, speaker } = Astro.props;
const base = import.meta.env.BASE_URL;
const frag = timeFragment(claim.start);
const moreId = `${claim.id}-more`;
const args = (claim.arguments ?? []).map((s) => getArticle('arguments', s));
const rhet = (claim.rhetoric ?? []).map((s) => getArticle('rhetoric', s));
// Вставки доводов и приёмов устроены одинаково: раскрывающийся блок с полным текстом статьи.
const insets = [
  ...args.map((a) => ({ ...a, kind: 'arguments', label: 'Повторяющийся довод' })),
  ...rhet.map((r) => ({ ...r, kind: 'rhetoric', label: 'Риторический приём' })),
];
const hasMore = insets.length > 0;
---
<article
  class={`claim r-${claim.rating}`}
  id={`t=${frag}`}
  data-id={claim.id}
  data-rating={claim.rating}
  data-start={claim.start}
  data-end={claim.end}
  aria-label={`Утверждение с ${formatTime(claim.start)}`}
>
  <div class="claim-head">
    <button type="button" class="tc" data-seek={claim.start} aria-label={`Включить видео с ${formatTime(claim.start)}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg>
      {formatTime(claim.start)}
    </button>
    <RatingPill rating={claim.rating} />
    <a class="anchor" href={`#t=${frag}`} title="Ссылка на это утверждение" aria-label={`Ссылка на утверждение с ${formatTime(claim.start)}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
    </a>
  </div>

  <blockquote class="quote">
    <span class="part-label">{speaker}</span>
    <p>{claim.text}</p>
  </blockquote>

  <div class="claim-body">
    <span class="part-label analysis-label">Наш разбор</span>
    <p class="verdict">{claim.verdict}</p>
  </div>

  {hasMore && (
    <>
      <div class="more" id={moreId} hidden>
        {insets.map((a) => (
          <details class={`inset inset-${a.kind}`}>
            <summary>
              <span class="inset-label">{a.label}</span>
              <span class="inset-title">{a.title}</span>
              <span class="inset-summary">{a.summary}</span>
              <span class="inset-cut" aria-hidden="true">
                <span class="when-closed">{a.pending ? 'Подробнее' : 'Читать разбор'}</span>
                <span class="when-open">Свернуть</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </summary>
            {a.pending
              ? <p class="pending-note">Подробный разбор {a.kind === 'arguments' ? 'этого довода' : 'этого приёма'} готовится. Список мест, где он встречается, — на отдельной странице.</p>
              : <div class="prose" set:html={a.html} />}
            <a class="inset-link" href={`${base}${a.kind}/${a.slug}/`}>Отдельная страница и все места, где он встречается →</a>
          </details>
        ))}
      </div>
      <button type="button" class="fold claim-cut" aria-expanded="false" aria-controls={moreId}>
        <span class="when-closed">Подробнее</span>
        <span class="when-open">Скрыть подробности</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </>
  )}
</article>
