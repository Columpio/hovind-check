---
import { getFeedback } from '../lib/data';
const feedback = getFeedback();
---
{feedback && (
  <div id="feedback" data-form={feedback.formUrl} data-entries={JSON.stringify(feedback.entries)}>
    <button type="button" class="fb-float" hidden aria-label="Отправить замечание к выделенному тексту">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Замечание к этому месту
    </button>
  </div>
)}
<script>
  import '../scripts/feedback';
</script>
