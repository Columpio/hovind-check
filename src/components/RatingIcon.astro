---
import type { Rating } from '../lib/data';
interface Props { rating: Rating; }
const { rating } = Astro.props;
// Иконка дублирует цвет, чтобы оценку было видно и без различения цветов.
---
<svg class={`ricon ricon-${rating}`} viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
  {rating === 'green' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {rating === 'neutral' && <path d="M6 12h12" />}
  {rating === 'orange' && <><path d="M12 4l9 16H3z" /><path d="M12 10v4" /><path d="M12 17.2v.1" /></>}
  {rating === 'red' && <><path d="M6.5 6.5l11 11" /><path d="M17.5 6.5l-11 11" /></>}
  {rating === 'purple' && <><path d="M4 5.5c3-1 5.5-.5 8 1.5v12.5c-2.5-2-5-2.5-8-1.5z" /><path d="M20 5.5c-3-1-5.5-.5-8 1.5v12.5c2.5-2 5-2.5 8-1.5z" /></>}
</svg>
